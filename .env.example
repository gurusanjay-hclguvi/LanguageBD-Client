# Where the API lives. Leave this BLANK for local development: the Vite dev
# server proxies /api to http://localhost:4000, so a relative path works.
#
# In production the client and the API are separate deployments, so this must
# be the full origin of the API project, with no trailing slash:
# VITE_API_URL=https://linguaroute-api.vercel.app
VITE_API_URL=
